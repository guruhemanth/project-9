# ==============================================================================
# CaterConnect Production Environment Template (.env.example)
# Copy this file to .env and fill with real cryptographic values.
# NEVER commit .env to source control.
# ==============================================================================

# Application Environment (development | staging | production)
NODE_ENV=production

# API Gateway Port
PORT=8080

# Database Configuration & Primary Connection String
# Format: postgresql://<user>:<password>@<host>:<port>/<db_name>
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/caterconnect
POSTGRES_USER=caterconnect_app
POSTGRES_PASSWORD=<strong-random-database-password>
POSTGRES_DB=caterconnect

# Authentication (Cryptographic Secret for HS256/JWT verification, min 32 chars)
JWT_SECRET=<minimum-32-char-cryptographic-random-string>

# CORS Whitelist (Comma-separated origins allowed to make API requests)
ALLOWED_ORIGINS=https://caterconnect.in,https://partner.caterconnect.in

# Razorpay Payment Gateway Credentials
RAZORPAY_KEY_ID=rzp_live_<your_key_id>
RAZORPAY_KEY_SECRET=<your_live_key_secret>
RAZORPAY_WEBHOOK_SECRET=<your_webhook_signature_secret>

# Frontend Client API Base URL
VITE_API_BASE_URL=https://api.caterconnect.in
